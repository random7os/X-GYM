{
  "name": "x-gym/backend",
  "type": "project",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "laravel/sanctum": "^3.0",
    "maatwebsite/excel": "^3.1",
    "pusher/pusher-php-server": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""]
  },
  "config": {
    "audit": {
      "block-insecure": false
    }
  }
}
